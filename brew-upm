#!/usr/bin/env python3
"""Upgrade Homebrew packages, skipping listed packages' patch releases."""

from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile


PACKAGE = re.compile(r"^(formula|cask):([a-zA-Z0-9][a-zA-Z0-9@+_.-]*(?:/[a-zA-Z0-9][a-zA-Z0-9@+_.-]*){0,2})$")
VERSION = re.compile(r"^v?(\d+(?:\.\d+)+)(?:_\d+)?(?:\+[a-zA-Z0-9.-]+)?$")


class UpmError(Exception):
    """A user-facing error that should not print a Python traceback."""


def config_path() -> Path:
    override = os.environ.get("BREW_UPM_CONFIG")
    if override:
        return Path(override).expanduser()
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    return config_home / "brew-upm" / "packages.txt"


def read_packages() -> set[str]:
    path = config_path()
    if not path.exists():
        return set()
    packages = set()
    for number, line in enumerate(path.read_text().splitlines(), 1):
        entry = line.split("#", 1)[0].strip()
        if not entry:
            continue
        if not PACKAGE.fullmatch(entry):
            raise UpmError(f"{path}:{number}: expected formula:name or cask:name.")
        packages.add(entry)
    return packages


def write_packages(packages: set[str]) -> None:
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_path = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as handle:
            temporary_path = Path(handle.name)
            handle.write("".join(f"{entry}\n" for entry in sorted(packages)))
        temporary_path.replace(path)
    finally:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)


def brew(arguments: list[str], capture: bool = False) -> str:
    environment = {**os.environ, "HOMEBREW_NO_AUTO_UPDATE": "1"}
    try:
        result = subprocess.run(
            ["brew", *arguments], check=True, text=True,
            capture_output=capture, env=environment,
        )
        return result.stdout if capture else ""
    except FileNotFoundError as error:
        raise UpmError("Homebrew command 'brew' was not found on PATH.") from error
    except subprocess.CalledProcessError as error:
        detail = (error.stderr or "").strip()
        raise UpmError(detail or f"brew {' '.join(arguments)} failed (exit {error.returncode}).") from error


def installed_packages() -> set[str]:
    formulae = brew(["list", "--formula", "--full-name"], capture=True).splitlines()
    casks = brew(["list", "--cask", "-1"], capture=True).splitlines()
    return {f"formula:{name}" for name in formulae} | {f"cask:{name}" for name in casks}


def resolve_package(value: str, candidates: set[str]) -> str:
    if ":" in value:
        matches = {value} & candidates
    else:
        matches = {
            entry for entry in candidates
            if value in {entry.split(":", 1)[1], entry.rsplit("/", 1)[-1].split(":", 1)[-1]}
        }
    if not matches:
        raise UpmError(f"Package '{value}' was not found. Use an installed Homebrew name (or a listed name for remove).")
    if len(matches) > 1:
        raise UpmError(f"Package '{value}' is ambiguous; choose {' or '.join(sorted(matches))}.")
    return matches.pop()


def version_tuple(value: str) -> tuple[int, ...] | None:
    match = VERSION.fullmatch(value.split(",", 1)[0].strip())
    return tuple(int(part) for part in match.group(1).split(".")) if match else None


def skip_reason(item: dict) -> str | None:
    installed = [version_tuple(value) for value in item.get("installed_versions", [])]
    current = version_tuple(item.get("current_version", ""))
    if not installed or current is None or any(value is None for value in installed):
        return "cannot compare versions; skipped"
    newest = max(installed)
    if current[:2] <= newest[:2]:
        return "patch/build update or no major/minor increase; skipped"
    return None


def upgrade_plan(data: dict, packages: set[str]) -> tuple[dict[str, list[str]], list[str]]:
    targets = {"formula": [], "cask": []}
    protected = []
    if not isinstance(data, dict) or not all(isinstance(data.get(key), list) for key in ("formulae", "casks")):
        raise UpmError("Unexpected brew outdated JSON: expected formulae and casks arrays.")
    for kind, key in (("formula", "formulae"), ("cask", "casks")):
        for item in data[key]:
            identity = f"{kind}:{item['name']}"
            if not PACKAGE.fullmatch(identity):
                raise UpmError(f"Unexpected package name from Homebrew: {identity!r}.")
            if item.get("pinned"):
                print(f"{identity}: already pinned; skipped")
                continue
            reason = skip_reason(item) if identity in packages else None
            if reason:
                print(f"{identity}: {reason}")
                protected.append(identity)
            else:
                targets[kind].append(item["name"])
    return targets, protected


@contextmanager
def upgrade_lock():
    # Temporary pins belong to one run, so concurrent upm runs must not overlap.
    lock_path = config_path().with_suffix(".lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise UpmError("Another brew upm run is active for this configuration.") from error
        yield


@contextmanager
def temporary_pins(packages: list[str]):
    created = []
    try:
        for identity in packages:
            kind, name = identity.split(":", 1)
            # Record first so a partially successful pin is also cleaned up.
            created.append((kind, name))
            brew(["pin", f"--{kind}", name])
        yield
    finally:
        failures = []
        for kind, name in reversed(created):
            try:
                brew(["unpin", f"--{kind}", name])
            except UpmError as error:
                failures.append(f"Run brew unpin --{kind} {name}: {error}")
        if failures:
            raise UpmError("Could not restore temporary pins. " + " ".join(failures))


def run_upgrade(packages: set[str], dry_run: bool) -> None:
    if not dry_run:
        brew(["update"])
    data = json.loads(brew(["outdated", "--json=v2"], capture=True))
    targets, protected = upgrade_plan(data, packages)
    if not any(targets.values()):
        print("No eligible updates.")
        return
    if dry_run:
        for kind, names in targets.items():
            for name in names:
                print(f"Would upgrade {kind}:{name}")
        print("Dry run: metadata was not refreshed; no packages or pins changed.")
        return
    # Pins protect skipped packages from automatic dependency/dependent upgrades.
    # Homebrew may reject an upgrade that requires a protected newer dependency.
    with temporary_pins(protected):
        for kind, names in targets.items():
            if names:
                brew(["upgrade", f"--{kind}", *names])


def arguments(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="brew upm", description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="preview using existing metadata; change nothing")
    commands = parser.add_subparsers(dest="command")
    commands.add_parser("list", help="show packages that skip patch updates")
    for command in ("add", "remove"):
        child = commands.add_parser(command, help=f"{command} packages in the list")
        child.add_argument("packages", nargs="+", metavar="PACKAGE")
    args = parser.parse_args(argv)
    if args.dry_run and args.command:
        parser.error("--dry-run is only valid without a subcommand")
    return args


def main(argv: list[str] | None = None) -> int:
    args = arguments(argv)
    try:
        packages = read_packages()
        if args.command == "list":
            print("\n".join(sorted(packages)) or "No packages listed.")
        elif args.command in {"add", "remove"}:
            candidates = installed_packages() if args.command == "add" else packages
            selected = {resolve_package(value, candidates) for value in args.packages}
            updated = packages | selected if args.command == "add" else packages - selected
            write_packages(updated)
            print(f"{'Added' if args.command == 'add' else 'Removed'}: {', '.join(sorted(selected))}")
        elif args.dry_run:
            run_upgrade(packages, dry_run=True)
        else:
            with upgrade_lock():
                run_upgrade(packages, dry_run=False)
        return 0
    except (UpmError, OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        print(f"brew upm: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("brew upm: interrupted.", file=sys.stderr)
        return 130


def interrupted(signum, frame):
    raise KeyboardInterrupt


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrupted)
    raise SystemExit(main())
